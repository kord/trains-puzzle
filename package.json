{
  "name": "trains-puzzle",
  "private": true,
  "version": "1.0.0",
  "description": "A Tracks logic puzzle: draw a single continuous railway that satisfies the row and column counts.",
  "license": "MIT",
  "homepage": "https://traintracks.therestinmotion.com/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && firebase deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "bench": "vitest run --config bench.config.ts --disableConsoleIntercept bench/bench-generate.test.ts",
    "compare": "vitest run --config bench.config.ts --disableConsoleIntercept bench/compare.test.ts",
    "profile": "vitest run --config bench.config.ts --disableConsoleIntercept bench/profile.test.ts",
    "rejections": "vitest run --config bench.config.ts --disableConsoleIntercept bench/rejections.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "logic-solver": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}